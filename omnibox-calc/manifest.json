{
  "manifest_version": 3,
  "name": "Brave QoL: Omnibox Calc",
  "short_name": "Calc",
  "version": "1.1.0",
  "description": "Instant calculations and unit or currency conversions in the address bar.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/joaodesousa/brave-qol",
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "="
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
