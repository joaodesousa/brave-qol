{
  "manifest_version": 3,
  "name": "Brave QoL: Full Page Capture",
  "version": "1.0.0",
  "description": "Capture an entire scrollable page as one image. No account, no cloud upload, no telemetry.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Capture full page (or press Alt+Shift+C)",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capture the full page as one image"
    }
  },
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "offscreen", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
